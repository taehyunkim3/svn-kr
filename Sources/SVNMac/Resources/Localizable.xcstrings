          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "생성된 리비전: %1$@"
          }
        }
      }
    },
    "repository.pathNormalization.resultSummary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ path(s) were renamed in %2$@ commit(s)."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "경로 %1$@개를 커밋 %2$@개로 개명했습니다."
          }
        }
      }
    },
    "repository.pathNormalization.reviewAction": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Review and Continue"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "확인하고 계속"
          }
        }
      }
