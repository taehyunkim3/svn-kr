    "repository.pathNormalization.windowsNote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Korean names stored with decomposed characters can appear as separate letters such as ‘ㅎㅏㄴㄱㅡㄹ’ on Windows. Fixing them makes the names display normally in Korean on Windows."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장소의 자모 분리 이름은 윈도우에서 ‘ㅎㅏㄴㄱㅡㄹ’처럼 낱자로 깨져 보입니다. 정리하면 윈도우에서도 정상적인 한글 이름으로 표시됩니다."
          }
        }
      }
    },
    "ui.recovery.cleanWorkingCopyCheckedOutServerOnlyRealLocalChanges": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A clean working copy is checked out from the server, then only real local changes are migrated using NFC paths. The current working folder and its files are not changed or deleted."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버에서 새 작업 폴더를 체크아웃한 뒤 실제 로컬 변경만 NFC 한글 경로로 옮깁니다. 현재 작업 폴더와 파일은 변경하거나 삭제하지 않습니다."
          }
        }
      }
    },
    "ui.error.conflictFilePathPointsOutsideWorkingCopy": {
      "extractionState": "manual",
