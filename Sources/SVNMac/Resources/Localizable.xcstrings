    "ui.working.copy.cleanup.failed.contact.support.81a7d2ce": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Working-copy cleanup failed. Do not retry cleanup repeatedly. Copy the details and contact your SVN administrator or check out a new working copy.\n\n%1$@"}},"ko":{"stringUnit":{"state":"translated","value":"작업 복사본 정리에 실패했습니다. 정리를 반복하지 말고 오류 원문을 복사해 SVN 관리자에게 전달하거나 작업 폴더를 새로 받으세요.\n\n%1$@"}}}},
    "ui.checkout.recovery.validation.failed.5fd4218c": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"The interrupted checkout folder is no longer a valid SVN working copy, so it cannot be continued.\n\n%1$@"}},"ko":{"stringUnit":{"state":"translated","value":"중단된 체크아웃 폴더가 더 이상 유효한 SVN 작업 복사본이 아니어서 이어받을 수 없습니다.\n\n%1$@"}}}},
