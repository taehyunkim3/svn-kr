    "repository.pathNormalization.running": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Renaming repository paths…"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장소 경로 개명 중…"
          }
        }
      }
    },
    "repository.pathNormalization.sameAppearanceNote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On macOS, decomposed (NFD) and composed (NFC) names can look identical, making the problem hard to notice. Compare each path's format badge and the code points for the differing components."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "맥에서는 자모 분리(NFD)와 완성형(NFC) 이름이 똑같이 보여 문제를 알아채기 어렵습니다. 각 경로의 형식 배지와 다른 부분의 코드포인트를 비교하세요."
          }
        }
      }
    },
    "repository.pathNormalization.scanAgain": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan Again"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다시 탐지"
          }
        }
      }
    },
    "repository.pathNormalization.scanning": {
      "extractionState": "manual",
      "localizations": {
