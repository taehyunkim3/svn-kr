    "ui.canceled.checkout.folder.not.emptied.9ea1354b": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"The folder was not emptied because it could not be verified safely as the interrupted SVN working copy.\n%1$@\n\n%2$@"}},"ko":{"stringUnit":{"state":"translated","value":"중단된 SVN 작업 복사본인지 안전하게 확인하지 못해 폴더를 비우지 않았습니다.\n%1$@\n\n%2$@"}}}},
    "ui.working.copy.operation.interrupted.run.cleanup.0bc374e1": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"The working-copy operation was interrupted. Run Working Copy Cleanup, then try the operation again.\n\n%1$@"}},"ko":{"stringUnit":{"state":"translated","value":"작업 복사본 작업이 중간에 끊겼습니다. 작업 복사본 정리를 실행한 뒤 다시 시도하세요.\n\n%1$@"}}}},
    "ui.file.remains.in.conflict.resolve.before.retry.4d17ac82": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"The file remains in conflict: %1$@\nGo to Changes, choose Resolve Conflicts, and resolve it before retrying.\n\n%2$@"}},"ko":{"stringUnit":{"state":"translated","value":"파일의 충돌이 남아 있습니다: %1$@\n변경 사항에서 충돌 해결을 열어 해결한 뒤 다시 시도하세요.\n\n%2$@"}}}},
    "ui.lock.belongs.to.another.working.copy.force.unlock.27e93bd0": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"This lock token does not belong to the current working copy. Review the owner, time, and comment, then use Force Release Lock if the server lock must be removed.\n\n%1$@"}},"ko":{"stringUnit":{"state":"translated","value":"이 잠금 토큰은 현재 작업 복사본에 속하지 않습니다. 소유자, 잠근 시각, 코멘트를 확인한 뒤 서버 잠금을 끊어야 하면 강제 해제를 사용하세요.\n\n%1$@"}}}},
