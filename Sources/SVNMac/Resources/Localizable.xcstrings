{
  "sourceLanguage": "ko",
  "strings": {
    "error.deletion.chooseMissingItems": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose how to handle locally missing items first: %1$@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "먼저 로컬 누락 항목의 처리 방법을 선택하세요: %1$@"
          }
        }
      }
    },
    "error.deletion.partial": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ item(s) were marked for deletion, but %2$@ failed: %3$@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@개는 삭제 예정으로 전환했고, %2$@개는 전환하지 못했습니다: %3$@"
          }
        }
      }
    },
    "error.deletion.validation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These items did not enter the pending-deletion state: %1$@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장소 삭제 예정 상태로 전환되지 않은 항목이 있습니다: %1$@"
          }
        }
      }
    },
    "error.recovery.fileReplacement": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Replacement files could not be restored to their original paths: %1$@. Backups: %2$@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대치 파일을 원래 위치로 복원하지 못했습니다: %1$@. 백업 파일: %2$@"
          }
        }
      }
    },
    "error.path.aliasRepair": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Korean path alias repair could not be validated: %1$@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한글 경로 별칭 정리를 검증하지 못했습니다: %1$@"
          }
        }
      }
    },
    "error.path.normalizationCollision": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Korean path normalization conflicts must be recovered before continuing: %1$@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한글 경로 충돌이 있어 작업을 중단했습니다: %1$@"
          }
        }
      }
    },
    "error.recovery.blocked": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some changes cannot be recovered automatically: %1$@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자동 복구할 수 없는 변경이 있습니다: %1$@"
          }
        }
      }
    },
    "error.recovery.validation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The recovered working copy did not pass validation: %1$@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 작업 폴더 검증에 실패했습니다: %1$@"
          }
        }
      }
    },
    "error.deletion.unresolvedMissingPaths": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose how to handle locally missing items first: %1$@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로컬 누락 항목의 처리 방법을 먼저 선택해야 합니다: %1$@"
          }
        }
      }
    },
    "error.path.unsupportedTarget": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paths containing line breaks cannot be passed safely to SVN: %1$@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "SVN 명령에 안전하게 전달할 수 없는 줄바꿈 경로가 있습니다: %1$@"
          }
        }
      }
    },
    "history.copy.copiedFrom": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copied from: %1$@%2$@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "복사 원본: %1$@%2$@"
          }
        }
      }
    },
    "recovery.path.reviewPaths": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Review these paths before automatic recovery: %1$@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자동 복구 전에 직접 확인해야 할 경로: %1$@"
          }
        }
      }
    },
    "repository.pathNormalization.action": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fix Korean Names"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한글 이름 정리"
          }
        }
      }
    },
    "repository.pathNormalization.actionHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Find decomposed Korean paths in the repository and rename selected paths to Windows-compatible names."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장소의 자모 분리 한글 경로를 찾아 선택한 경로를 윈도우 호환 이름으로 바꿉니다."
          }
        }
      }
    },
    "repository.pathNormalization.after": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "개명 후"
          }
        }
      }
    },
    "repository.pathNormalization.before": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Before"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "개명 전"
          }
        }
      }
    },
    "repository.pathNormalization.codepointsDetail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, %2$@ scalars"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, %2$@자"
          }
        }
      }
    },
    "repository.pathNormalization.confirmationCommits": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This creates %1$@ repository commit(s), one for each selected path."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 경로마다 하나씩, 저장소에 커밋 %1$@개가 생성됩니다."
          }
        }
      }
    },
    "repository.pathNormalization.confirmationDeleteAdd": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In other team members' working copies, these changes appear as file deletions and additions."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 팀원의 작업 복사본에서는 이 변경이 파일 삭제와 추가로 보입니다."
          }
        }
      }
    },
    "repository.pathNormalization.confirmationDirectory": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Renaming a folder moves everything below it together."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "폴더를 개명하면 그 아래의 모든 항목이 함께 이동합니다."
          }
        }
      }
    },
    "repository.pathNormalization.confirmationRun": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create %1$@ Commit(s)"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "커밋 %1$@개 생성"
          }
        }
      }
    },
    "repository.pathNormalization.confirmationTeam": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask team members to commit their in-progress changes before continuing."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "진행 전에 팀원들이 작업 중인 변경을 커밋해 두는 것이 좋습니다."
          }
        }
      }
    },
    "repository.pathNormalization.confirmationTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirm Repository Renames"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장소 개명 실행 확인"
          }
        }
      }
    },
    "repository.pathNormalization.defaultCommitMessage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Normalize Korean filenames for Windows compatibility"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한글 파일 이름을 윈도우 호환 형식으로 정리"
          }
        }
      }
    },
    "repository.pathNormalization.deselectAll": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deselect All"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전체 선택 해제"
          }
        }
      }
    },
    "repository.pathNormalization.differentComponent": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Different component"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 부분"
          }
        }
      }
    },
    "repository.pathNormalization.directoryNote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Renaming a folder moves all files and folders below it together."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "폴더를 개명하면 하위의 모든 파일과 폴더가 함께 이동합니다."
          }
        }
      }
    },
    "repository.pathNormalization.errorInvalidTargets": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some rename targets are no longer valid. Scan the repository again and review the paths below."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일부 개명 대상이 더 이상 유효하지 않습니다. 저장소를 다시 탐지하고 아래 경로를 확인하세요."
          }
        }
      }
    },
    "repository.pathNormalization.errorLocalChanges": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Local changes block these renames. Commit or revert the paths below before trying again."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로컬 변경 때문에 개명을 실행할 수 없습니다. 아래 경로를 먼저 커밋하거나 되돌린 뒤 다시 실행하세요."
          }
        }
      }
    },
    "repository.pathNormalization.errorLocks": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Repository locks block these renames. Release the locks on the paths below before trying again."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장소 잠금 때문에 개명을 실행할 수 없습니다. 아래 경로의 잠금을 먼저 해제한 뒤 다시 실행하세요."
          }
        }
      }
    },
    "repository.pathNormalization.errorPartialFailure": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ rename(s) were already committed to the server and cannot be undone here. The operation stopped at %2$@: %3$@. Run the scan again to continue with the remaining paths; do not treat the completed commits as failed."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "개명 %1$@개는 이미 서버에 커밋되어 여기서 되돌릴 수 없습니다. %2$@에서 중단되었습니다: %3$@. 다시 탐지해 실행하면 남은 경로부터 이어서 처리됩니다. 완료된 커밋을 실패로 취급하지 마세요."
          }
        }
      }
    },
    "repository.pathNormalization.errorUnknown": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Repository path normalization failed."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장소 경로 정리에 실패했습니다."
          }
        }
      }
    },
    "repository.pathNormalization.formComposed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Composed characters (NFC)"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "완성형 (NFC)"
          }
        }
      }
    },
    "repository.pathNormalization.formDecomposed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Decomposed characters (NFD)"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자모 분리 (NFD)"
          }
        }
      }
    },
    "repository.pathNormalization.noPaths": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This repository has no decomposed Korean paths that would appear broken on Windows."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 저장소에는 윈도우에서 깨져 보일 자모 분리 한글 경로가 없습니다."
          }
        }
      }
    },
    "repository.pathNormalization.problem": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Action Required"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "확인할 문제"
          }
        }
      }
    },
    "repository.pathNormalization.result": {
      "extractionState": "manual",
      "localizations": {
