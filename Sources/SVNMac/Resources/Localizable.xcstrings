          }
        }
      }
    },
    "ui.authentication.cancelingDoesNotPreventViewingLocalChangesDiffs": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Canceling does not prevent viewing local changes and diffs."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "취소해도 로컬 변경 사항과 diff는 계속 확인할 수 있습니다."
          }
        }
      }
    },
    "ui.certificate.exceptionNotAllowedNoProjectSettingChanged": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The certificate exception was not allowed. No project setting changed."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "인증서 예외를 허용하지 않았습니다. 프로젝트 설정은 바뀌지 않았습니다."
          }
        }
      }
    },
    "ui.certificate.savedCertificateExceptionRetrySvnOperation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saved the certificate exception for %1$@. Retry the SVN operation."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@의 인증서 예외를 저장했습니다. SVN 작업을 다시 실행하세요."
          }
        }
      }
    },
    "ui.certificate.exceptionSecurityWarning": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allowing this exception weakens server identity verification for this project. A malicious server could impersonate your SVN server."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 예외를 허용하면 해당 프로젝트의 서버 신원 검증이 약해집니다. 악성 서버가 SVN 서버를 사칭할 수 있습니다."
          }
        }
      }
    },
    "ui.certificate.serverCertificateExpiredRenewingItSafestAllowingItLetsProject": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server certificate has expired. Renewing it is safest. Allowing it lets this project connect without rejecting that expiration."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버 인증서가 만료됐습니다. 인증서를 갱신하는 것이 가장 안전합니다. 허용하면 이 프로젝트는 해당 만료 오류를 무시하고 연결합니다."
          }
        }
      }
    },
    "ui.certificate.issuedDifferentHostnameCheckRepositoryUrlCertificateHostnameBeforeAllowing": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The certificate was issued for a different hostname. Check the repository URL and certificate hostname before allowing this mismatch."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "인증서가 다른 서버 이름으로 발급됐습니다. 허용하기 전에 저장소 URL과 인증서의 서버 이름을 확인하세요."
          }
        }
      }
    },
    "ui.certificate.notYetValidCheckServerMacClocksCertificateStartDate": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The certificate is not yet valid. Check the server and Mac clocks and the certificate start date before allowing it; correcting the clocks is safer than trusting the certificate."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "인증서의 유효 기간이 아직 시작되지 않았습니다. 허용하기 전에 서버와 Mac의 시계 및 인증서 시작일을 확인하세요. 인증서를 신뢰하는 것보다 시계를 바로잡는 것이 안전합니다."
          }
        }
      }
    },
    "ui.certificate.svnReportedCertificateProblemButDidNotIdentifySupportedReason": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "SVN reported a certificate problem but did not identify a supported reason. The app cannot safely create a specific exception. Contact the server administrator and replace or repair the certificate."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "SVN이 인증서 문제를 보고했지만 지원하는 원인을 특정하지 않았습니다. 앱은 안전한 개별 예외를 만들 수 없습니다. 서버 관리자에게 문의해 인증서를 교체하거나 수정하세요."
          }
        }
      }
    },
    "ui.certificate.issuerNotTrustedConfirmIssuerServerAdministratorAllowingItBypasses": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The certificate issuer is not trusted. Confirm the issuer with your server administrator. Allowing it bypasses authority verification for this project."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "인증서 발급 기관을 신뢰할 수 없습니다. 서버 관리자에게 발급 기관을 확인하세요. 허용하면 이 프로젝트에서 발급 기관 검증을 건너뜁니다."
          }
        }
      }
    },
