    "ui.only.verified.working.copy.will.be.deleted.path.d8c0a71e": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"All contents of the verified interrupted SVN working-copy folder below will be deleted. This cannot be undone.\n\n%1$@"}},"ko":{"stringUnit":{"state":"translated","value":"아래 경로가 중단된 SVN 작업 복사본인지 다시 확인한 뒤 폴더 안의 모든 내용을 삭제합니다. 되돌릴 수 없습니다.\n\n%1$@"}}}},
    "ui.checkout.folder.was.not.empty.cannot.delete.0e6d49b2": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"This folder already had files before checkout, so the app will not empty it. Continue the checkout or close this message and review the folder in Finder."}},"ko":{"stringUnit":{"state":"translated","value":"체크아웃 전부터 파일이 있던 폴더라 앱에서 비울 수 없습니다. 이어서 받거나 이 안내를 닫고 Finder에서 폴더 내용을 확인하세요."}}}}
